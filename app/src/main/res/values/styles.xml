<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Estilos de texto de acordo com o sistema de design da Scania (Tegel) -->
    <style name="TextStyle.Scania.Headline" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textColor">@color/scania_grey</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextStyle.Scania.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/scania_grey</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextStyle.Scania.Subtitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/scania_grey</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextStyle.Scania.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/scania_grey</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextStyle.Scania.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/scania_grey</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Estilos de botões -->
    <style name="ButtonStyle.Scania.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/scania_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ButtonStyle.Scania.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/scania_grey_light</item>
        <item name="android:textColor">@color/scania_blue</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Estilo para Cards -->
    <style name="CardStyle.Scania" parent="CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
</resources>