<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="@color/colorOnPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="30dp"
                android:src="@drawable/scania_logo"
                android:contentDescription="Scania Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Drone AutoFly"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Drone Status Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_drone_status"
        style="@style/CardStyle.Scania"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextStyle.Scania.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status do Drone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextStyle.Scania.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status da Conexão" />

                    <TextView
                        android:id="@+id/tv_connection_status"
                        style="@style/TextStyle.Scania.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desconectado"
                        android:textColor="@color/scania_red" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextStyle.Scania.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bateria" />

                    <TextView
                        android:id="@+id/tv_battery_level"
                        style="@style/TextStyle.Scania.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextStyle.Scania.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Altitude" />

                    <TextView
                        android:id="@+id/tv_altitude"
                        style="@style/TextStyle.Scania.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Video Stream Card with Scania Logo as Placeholder -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_video_stream"
        style="@style/CardStyle.Scania"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/card_mission_controls"
        app:layout_constraintTop_toBottomOf="@id/card_drone_status">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Placeholder Logo (visible when stream not connected) -->
            <ImageView
                android:id="@+id/img_stream_placeholder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/scania_grey_100"
                android:padding="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/scania_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Actual Video Stream (initially invisible) -->
            <TextureView
                android:id="@+id/texture_video_stream"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Overlay with Mission Status -->
            <TextView
                android:id="@+id/tv_mission_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:padding="8dp"
                android:text="Aguardando início da missão"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Mission Controls Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_mission_controls"
        style="@style/CardStyle.Scania"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/card_barcodes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextStyle.Scania.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Controles de Missão" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start_mission"
                    style="@style/ButtonStyle.Scania.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Iniciar Missão" />

                <Button
                    android:id="@+id/btn_pause_mission"
                    style="@style/ButtonStyle.Scania.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Pausar" />

                <Button
                    android:id="@+id/btn_stop_mission"
                    style="@style/ButtonStyle.Scania.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Parar" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_ai_control"
                style="@style/ButtonStyle.Scania.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@android:drawable/ic_menu_send"
                android:drawablePadding="8dp"
                android:padding="12dp"
                android:text="Controle por IA" />
                
            <Button
                android:id="@+id/btn_analytics"
                style="@style/ButtonStyle.Scania.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="8dp"
                android:padding="12dp"
                android:text="Ver Dashboard de Análise" />
                
            <Button
                android:id="@+id/btn_flight_path"
                style="@style/ButtonStyle.Scania.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@android:drawable/ic_menu_compass"
                android:drawablePadding="8dp"
                android:padding="12dp"
                android:text="Visualizar Caminho de Voo" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scanned Barcodes Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_barcodes"
        style="@style/CardStyle.Scania"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                style="@style/TextStyle.Scania.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Códigos de Barras Escaneados" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_scanned_barcodes"
                    style="@style/TextStyle.Scania.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nenhum código de barras escaneado ainda" />
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>